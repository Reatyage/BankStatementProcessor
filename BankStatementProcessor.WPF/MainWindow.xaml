<Window x:Class="BankStatementProcessor.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка выписок в 1С"
        Height="950" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#06B6D4" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#06B6D4" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F59E0B" Offset="0"/>
            <GradientStop Color="#EF4444" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassCard" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#40FFFFFF" Offset="0"/>
            <GradientStop Color="#26FFFFFF" Offset="0.5"/>
            <GradientStop Color="#14FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D9E0F2FE" Offset="0"/>
            <GradientStop Color="#E5F0F9FF" Offset="0.5"/>
            <GradientStop Color="#D9F5F3FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassShine" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#66FFFFFF" Offset="0"/>
            <GradientStop Color="#1AFFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#E5FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#8B5CF6"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="30" Background="{StaticResource GlassBackground}"
            BorderBrush="#FFFFFF" BorderThickness="1.5" ClipToBounds="True">
        <Grid>
            <Border CornerRadius="30" Background="{StaticResource GlassShine}" IsHitTestVisible="False"/>

            <Grid Margin="35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ЗАГОЛОВОК -->
                <Grid Grid.Row="0" Margin="0,-10,0,15">
                    <TextBlock Text="Загрузка банковских выписок в 1С" FontSize="32" FontWeight="Bold"
                               Foreground="#0F172A" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,0,0">
                        <Button Content="-" Style="{StaticResource WindowControlButton}" Click="Minimize_Click" ToolTip="Свернуть"/>
                        <Button Content="□" Style="{StaticResource WindowControlButton}" Click="Maximize_Click" ToolTip="Развернуть/Восстановить"/>
                        <Button Content="×" Style="{StaticResource WindowControlButton}" Click="Close_Click" ToolTip="Закрыть"/>
                    </StackPanel>
                </Grid>

                <!-- НАСТРОЙКИ -->
                <Border Grid.Row="1" CornerRadius="24" Background="{StaticResource GlassCard}"
                        BorderBrush="#FFFFFF" BorderThickness="1.5" Padding="30" Margin="0,0,0,20">
                    <Grid>
                        <Border CornerRadius="24" Background="{StaticResource GlassShine}" IsHitTestVisible="False" Opacity="0.6"/>
                        <StackPanel>
                            <TextBlock FontSize="22" Foreground="#0F172A" Margin="0,0,0,20">
								<Run FontFamily="Segoe MDL2 Assets" Text="&#xE713;"/>
								<Run Text=" Настройки"/>
                            </TextBlock>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- ✅ ПАПКА (Segoe Fluent Icons) -->
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#334155" FontSize="15" FontWeight="Medium">
									<Run FontFamily="Segoe Fluent Icons" Text="&#xE8B7;"/>
									<Run Text=" Папка:"/>
                                </TextBlock>
                                <TextBox Grid.Column="1" x:Name="txtFolderPath" Style="{StaticResource GlassTextBox}" Margin="15,0,5,0"/>
                                <Button Grid.Column="2" Click="BtnBrowse_Click" Margin="5,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{StaticResource SuccessGradient}" CornerRadius="20" Padding="25,12">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                                                </Border.Effect>
                                                <TextBlock Text="Обзор" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="3" Click="BtnOpenFolder_Click" ToolTip="Открыть папку в проводнике"
                                        Width="40" Height="40" Background="Transparent" BorderThickness="0"
                                        FontSize="18" FontFamily="Segoe MDL2 Assets" Cursor="Hand" Margin="5,0"
                                        Content="&#xE838;" Foreground="#64748B"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- ✅ XML (Segoe Fluent Icons) -->
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#334155" FontSize="15" FontWeight="Medium">
									<Run FontFamily="Segoe Fluent Icons" Text="&#xE8A5;"/>
									<Run Text=" XML:"/>
                                </TextBlock>
                                <TextBox Grid.Column="1" x:Name="txtXmlPath" Style="{StaticResource GlassTextBox}" IsReadOnly="True" Margin="15,0,5,0"/>
                                <Button Grid.Column="2" Click="BtnBrowseXml_Click" Margin="5,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{StaticResource SuccessGradient}" CornerRadius="20" Padding="25,12">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                                                </Border.Effect>
                                                <TextBlock Text="Обзор" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="3" Click="BtnCopyPath_Click" ToolTip="Скопировать путь"
                                        Width="40" Height="40" Background="Transparent" Foreground="#64748B" BorderThickness="0"
                                        FontSize="18" FontFamily="Segoe MDL2 Assets" Cursor="Hand" Margin="5,0"
                                        Content="&#xE8C8;"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- КНОПКИ ДЕЙСТВИЙ -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Button x:Name="btnStart" Click="BtnStart_Click" Margin="0,0,15,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource PrimaryGradient}" CornerRadius="30" Padding="40,18">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#8B5CF6" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                                    </Border.Effect>
                                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center">
										<Run FontFamily="Segoe MDL2 Assets" Text="&#xE768;"/>
										<Run Text=" Запустить обработку"/>
                                    </TextBlock>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Click="BtnLogs_Click" Margin="0,0,15,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource GlassCard}" BorderBrush="#FFFFFF" BorderThickness="1.5" CornerRadius="30" Padding="30,18">
                                    <TextBlock FontSize="15" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center">
										<Run FontFamily="Segoe MDL2 Assets" Text="&#xF0E3;"/>
										<Run Text=" Логи"/>
                                    </TextBlock>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Click="BtnClearLog_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource WarningGradient}" CornerRadius="30" Padding="30,18">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#F59E0B" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                                    </Border.Effect>
                                    <TextBlock FontSize="15" FontWeight="Medium" Foreground="White" HorizontalAlignment="Center">
										<Run FontFamily="Segoe MDL2 Assets" Text="&#xE74D;"/>
										<Run Text=" Очистить"/>
                                    </TextBlock>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- ПАНЕЛЬ СОМНИТЕЛЬНЫХ ОПЕРАЦИЙ -->
                <Border Grid.Row="3" CornerRadius="24" Background="{StaticResource GlassCard}" 
                        BorderBrush="#FFFFFF" BorderThickness="1.5" Margin="0,0,0,15">
                    <Expander x:Name="expSuspicious" Header="⚠️ Требуют проверки (Сомнительные операции)" 
                              Padding="15" IsExpanded="False">
                        <DataGrid x:Name="dgSuspicious" AutoGenerateColumns="False" CanUserAddRows="False"
                                  Height="150" GridLinesVisibility="Horizontal" Background="Transparent"
                                  BorderThickness="0" RowBackground="Transparent" AlternatingRowBackground="#10FFFFFF">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="90" Foreground="#0F172A"/>
                                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N2}" Width="100" Foreground="#0F172A"/>
                                <DataGridTextColumn Header="Текущий контрагент" Binding="{Binding Counterparty}" Width="*" Foreground="#0F172A"/>
                                <DataGridTextColumn Header="Предложение ИИ" Binding="{Binding AiSuggestion}" Width="*" Foreground="#0F172A"/>
                                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="130" Foreground="#0F172A"/>
                            </DataGrid.Columns>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>
                    </Expander>
                </Border>

                <!-- ЖУРНАЛ ОПЕРАЦИЙ -->
                <Border Grid.Row="4" CornerRadius="24" Background="{StaticResource GlassCard}"
                        BorderBrush="#FFFFFF" BorderThickness="1.5" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Border CornerRadius="24" Background="{StaticResource GlassShine}" IsHitTestVisible="False" Opacity="0.4"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" FontSize="20" Foreground="#0F172A" Margin="0,0,0,15">
								<Run FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;"/>
								<Run Text=" Журнал операций"/>
                            </TextBlock>
                            <ScrollViewer Grid.Row="1" x:Name="logScrollViewer" 
                                          VerticalScrollBarVisibility="Auto" 
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBox x:Name="txtLog" IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="14" Background="Transparent"
                                         Foreground="#059669" BorderThickness="0" Padding="12"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         ScrollViewer.CanContentScroll="True"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- СТАТИСТИКА И ПРОГРЕСС -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,25,0">
                        <TextBlock x:Name="txtProgress" Text="Готов к работе" Foreground="#334155" FontSize="15" FontWeight="Medium" Margin="0,0,0,10"/>
                        <Border CornerRadius="18" Background="{StaticResource GlassCard}" BorderBrush="#FFFFFF" BorderThickness="1" Height="36">
                            <ProgressBar x:Name="progressBar" Height="36" Minimum="0" Maximum="100" Value="0" Background="Transparent" BorderThickness="0">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border x:Name="PART_Track" CornerRadius="18" Background="{TemplateBinding Background}"/>
                                            <Border x:Name="PART_Indicator" CornerRadius="18" HorizontalAlignment="Left">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                                        <GradientStop Color="#06B6D4" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border CornerRadius="25" Background="{StaticResource SuccessGradient}" Padding="25,18" Margin="8,0" MinWidth="130">
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Обработано" Foreground="White" FontSize="12" HorizontalAlignment="Center" Opacity="0.9"/>
                                <TextBlock x:Name="txtProcessed" Text="0" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="25" Background="{StaticResource WarningGradient}" Padding="25,18" Margin="8,0" MinWidth="130">
                            <Border.Effect>
                                <DropShadowEffect Color="#F59E0B" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Ошибки" Foreground="White" FontSize="12" HorizontalAlignment="Center" Opacity="0.9"/>
                                <TextBlock x:Name="txtErrors" Text="0" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="25" Background="{StaticResource PrimaryGradient}" Padding="25,18" Margin="8,0" MinWidth="130">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Пропущено" Foreground="White" FontSize="12" HorizontalAlignment="Center" Opacity="0.9"/>
                                <TextBlock x:Name="txtSkipped" Text="0" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>